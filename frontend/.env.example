# Frontend Application URL (used for OAuth redirects)
# Local development: defaults to http://localhost:5173
# Production: set to your deployed domain (e.g. https://valgent.vercel.app)
VITE_APP_URL=http://localhost:5173

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API Base URL
# In local development: defaults to http://localhost:3000/api/v1
# In production: point to your deployed backend (e.g. https://valgent.onrender.com/api/v1)
VITE_API_BASE_URL=http://localhost:3000/api/v1
